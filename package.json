{
  "name": "bolt-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "resolutions": {
    "hermes-compiler": "250829098.0.4"
  },
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint:fix": "eslint . --fix",
    "build:dev:android": "eas build -p android --profile development",
    "build:dev:ios": "eas build -p ios --profile development",
    "build:preview:android": "eas build -p android --profile preview",
    "build:preview:ios": "eas build -p ios --profile preview",
    "build:preview:all": "eas build --platform all --profile preview",
    "build:prod:android": "eas build -p android --profile production",
    "build:prod:ios": "eas build -p ios --profile production",
    "build:prod:all": "eas build --platform all --profile production",
    "submit:prod:android": "eas submit -p android --profile production",
    "submit:prod:ios": "eas submit -p ios --profile production",
    "build:list": "eas build:list",
    "build:download": "eas build:download"
  },
  "dependencies": {
    "@expo-google-fonts/material-symbols": "^0.4.16",
    "@expo/vector-icons": "^15.0.2",
    "@legendapp/list": "^2.0.11",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "expo": "~55.0.5",
    "expo-av": "~16.0.8",
    "expo-blur": "~55.0.10",
    "expo-build-properties": "~55.0.10",
    "expo-camera": "~55.0.11",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.19",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-linear-gradient": "~55.0.9",
    "expo-linking": "~55.0.9",
    "expo-notifications": "~55.0.14",
    "expo-router": "~55.0.8",
    "expo-screen-orientation": "~55.0.9",
    "expo-secure-store": "~55.0.9",
    "expo-splash-screen": "~55.0.13",
    "expo-sqlite": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.11",
    "expo-updates": "~55.0.16",
    "expo-web-browser": "~55.0.10",
    "lucide-react-native": "^0.475.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "3.3.3",
    "react-native-nitro-modules": "0.33.8",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "zustand": "^5.0.9"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^55.0.13",
    "eslint-config-expo": "^55.0.0",
    "jest-expo": "^55.0.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
