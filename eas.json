{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "environment": "development",
      "distribution": "internal",
      "developmentClient": true,
      "env": {
        "APP_ENV": "development",
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "environment": "preview",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "staging",
        "APP_VARIANT": "preview"
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "distribution": "store",
      "env": {
        "APP_ENV": "production",
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}